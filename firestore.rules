rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('activeDeviceId' in data) || (data.activeDeviceId is string && data.activeDeviceId.size() <= 128)) &&
             data.refreshIntervalSeconds is int &&
             data.refreshIntervalSeconds >= 2 &&
             data.refreshIntervalSeconds <= 60 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidDeviceProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 60 &&
             data.host is string &&
             data.host.size() >= 1 &&
             data.host.size() <= 255 &&
             data.port is int &&
             data.port >= 1 &&
             data.port <= 65535 &&
             data.useHttps is bool &&
             data.apiVersion is string &&
             data.apiVersion in ['V6', 'V5'] &&
             data.basePath is string &&
             data.basePath.size() <= 64 &&
             data.locationTag is string &&
             data.locationTag.size() <= 40 &&
             data.notes is string &&
             data.notes.size() <= 240 &&
             data.hasStoredCredential is bool &&
             data.lastConnectedAtMs is int &&
             data.lastConnectedAtMs >= 0 &&
             data.lastConnectedAtMs <= 9999999999999 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidAuditLog(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.deviceId is string &&
             data.deviceId.size() >= 1 &&
             data.deviceId.size() <= 128 &&
             data.deviceName is string &&
             data.deviceName.size() >= 1 &&
             data.deviceName.size() <= 60 &&
             data.actionType is string &&
             data.actionType in [
               'BLOCKING_ENABLED',
               'BLOCKING_DISABLED',
               'WHITELIST_ADD',
               'WHITELIST_REMOVE',
               'BLACKLIST_ADD',
               'BLACKLIST_REMOVE',
               'DEVICE_ADDED',
               'DEVICE_UPDATED',
               'DEVICE_REMOVED',
               'GRAVITY_UPDATE'
             ] &&
             data.target is string &&
             data.target.size() <= 255 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    // --- COLLECTION RULES ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().keys().hasAll([
                         'userId',
                         'displayName',
                         'refreshIntervalSeconds',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'displayName',
                         'email',
                         'activeDeviceId',
                         'refreshIntervalSeconds',
                         'createdAt',
                         'updatedAt'
                       ]);

      allow update: if isSignedIn() &&
                       isValidUserProfile(incoming()) &&
                       isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['activeDeviceId', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['refreshIntervalSeconds', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName',
                           'email',
                           'activeDeviceId',
                           'refreshIntervalSeconds',
                           'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(userId);

      match /devices/{deviceId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(deviceId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(deviceId) &&
                         isValidDeviceProfile(incoming()) &&
                         incoming().keys().hasAll([
                           'userId',
                           'name',
                           'host',
                           'port',
                           'useHttps',
                           'apiVersion',
                           'basePath',
                           'locationTag',
                           'notes',
                           'hasStoredCredential',
                           'lastConnectedAtMs',
                           'createdAt',
                           'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId',
                           'name',
                           'host',
                           'port',
                           'useHttps',
                           'apiVersion',
                           'basePath',
                           'locationTag',
                           'notes',
                           'hasStoredCredential',
                           'lastConnectedAtMs',
                           'createdAt',
                           'updatedAt'
                         ]);

        allow update: if isSignedIn() &&
                         isValidDeviceProfile(incoming()) &&
                         isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(deviceId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().diff(existing()).affectedKeys().hasOnly(['lastConnectedAtMs', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly(['hasStoredCredential', 'updatedAt']) ||
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name',
                             'host',
                             'port',
                             'useHttps',
                             'apiVersion',
                             'basePath',
                             'locationTag',
                             'notes',
                             'hasStoredCredential',
                             'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(deviceId);
      }

      match /auditLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(logId) &&
                         isValidAuditLog(incoming()) &&
                         incoming().keys().hasAll([
                           'userId',
                           'deviceId',
                           'deviceName',
                           'actionType',
                           'target',
                           'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId',
                           'deviceId',
                           'deviceName',
                           'actionType',
                           'target',
                           'createdAt'
                         ]);

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(logId);
      }
    }
  }
}
